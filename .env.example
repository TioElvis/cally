# Cally environment — copy to .env (git-ignored) and fill in as milestones need them.
# No real secret is ever committed. Everything is optional until the milestone
# that introduces it (see docs/KEYS-AND-ACCOUNTS.md). M0 (month view) needs none.

# --- M7: purchases (only if using RevenueCat; otherwise use in_app_purchase) ---
REVENUECAT_PUBLIC_SDK_KEY=

# --- Optional, privacy-reviewed, not in the default build ---
# Crash reporting (prefer Sentry over Crashlytics if ever added)
SENTRY_DSN=

# --- Optional, only if we ever embed a map instead of opening external apps ---
MAPS_API_KEY=

# --- Optional, only if we ever add in-app provider sign-in (we don't plan to) ---
GOOGLE_OAUTH_CLIENT_ID_IOS=
GOOGLE_OAUTH_CLIENT_ID_ANDROID=
MICROSOFT_GRAPH_CLIENT_ID=
